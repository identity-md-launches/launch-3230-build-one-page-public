{
  "name": "swarmcard",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "render": "node --import tsx scripts/render.tsx",
    "dev": "npm run render && vite --host 0.0.0.0",
    "build": "npm run render && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --host 0.0.0.0",
    "share": "node scripts/generate-share.mjs",
    "check": "node scripts/check.mjs",
    "check:bundle": "node scripts/check-bundle.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "linkedom": "^0.18.15",
    "playwright": "^1.65.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
